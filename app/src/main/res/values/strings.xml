    <!-- v0.6.0 · Help additions -->
    <string name="help_link_edit_title">Editing a link</string>
    <string name="help_link_edit_1">Tap a link on the board — or its name chip — and the link inspector opens.</string>
    <string name="help_link_edit_2">It shows which two nodes the link joins and what the relation means.</string>
    <string name="help_link_edit_3">Change the relation, swap its direction, give it a colour or your own phrase.</string>
    <string name="help_link_edit_4">Delete it — Undo appears in the message at the bottom.</string>
    <string name="help_link_edit_5">Every link is also reachable from inside a node: Links out and Links in.</string>
    <string name="help_structure_title">Structure</string>
    <string name="help_structure_1">Set a node as the central node — more than one is allowed, each starts its own tree.</string>
    <string name="help_structure_2">Order the branches of a node with the arrows; Arrange follows that order.</string>
    <string name="help_structure_3">Collapse a branch to hide its subtree, expand to bring it back. Nothing is deleted.</string>
    <string name="help_structure_4">Move a node and everything under it with the four direction buttons.</string>
    <string name="help_structure_5">Arrange lays the map out in the direction and spacing chosen in the settings.</string>
    <string name="help_board_mode_title">Board mode and theme</string>
    <string name="help_board_mode_1">The settings button at the top-left opens the project settings.</string>
    <string name="help_board_mode_2">Eight board surfaces: plain, grid, dots, graph paper, ruled lines, isometric, hex and blueprint.</string>
    <string name="help_board_mode_3">Six board themes — app theme, paper, warm, mint, charcoal and blueprint.</string>

