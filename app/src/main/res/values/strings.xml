    <string name="tool_origin">Origin</string>
    <string name="origin_here">Origin — the fixed zero point of this board</string>
    <string name="settings_origin">Show the origin</string>
    <string name="settings_origin_detail">The dot in a ring is board (0, 0). Arrange puts the central node there.</string>
    <string name="help_origin_1">The board has one fixed point, its origin (0, 0) — the dot in a ring.</string>
    <string name="help_origin_2">Arrange moves the central node onto the origin and builds the map from there, so arranging twice always gives the same result.</string>
    <string name="help_origin_3">The Origin button brings the view back to it, wherever you have travelled.</string>

